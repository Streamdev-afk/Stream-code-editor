# Copy this to .env and fill in your real values. NEVER commit .env.
# Stream now shares the ION Supabase project (same users, one login).

# --- AI ---
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# --- Supabase (frontend, safe to expose: this is the public anon key) ---
VITE_SUPABASE_URL=https://nhiqbargpexlcmbchmtn.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_from_the_ion_project

# --- Supabase (backend only, KEEP SECRET) ---
SUPABASE_URL=https://nhiqbargpexlcmbchmtn.supabase.co
SUPABASE_ANON_KEY=your_anon_key_from_the_ion_project
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_from_the_ion_project

# --- GitHub token encryption (32 random bytes, base64). Make one with:  openssl rand -base64 32 ---
GITHUB_TOKEN_ENCRYPTION_KEY=

# --- Paystack ---
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PLAN_PRO3X=PLN_your_3x_plan_code
PAYSTACK_PLAN_PRO5X=PLN_your_5x_plan_code
PAYSTACK_PLAN_PRO10X=PLN_your_10x_plan_code

# --- URLs ---
FRONTEND_URL=http://localhost:5173
